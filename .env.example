# All settings are optional. Copy to .env and fill in what you need.

# Gemini scene description ("what did I draw"). Without a key, AI stays off.
GOOGLE_API_KEY=your_google_api_key
GEMINI_API_KEY=your_gemini_api_key
# Optional Gemini model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Wake word (detected locally with openWakeWord)
OPENWAKEWORD_MODEL_PATH=C:\path\to\hey_aria.onnx
OPENWAKEWORD_BUILTIN=hey_jarvis

# Voice command transcription uses Google's web speech recognition (cloud).
# 1 = enabled (default), 0 = disabled (wake word still works; commands won't).
ALLOW_CLOUD_SPEECH_RECOGNITION=1

# Camera stream ARIA requests. Most webcams default to 640x480 unless asked
# for more; set these to a mode your device actually supports if 1280x720 is
# refused (the startup log prints what was granted).
ARIA_CAMERA_WIDTH=1280
ARIA_CAMERA_HEIGHT=720
# 1 = request MJPG (needed for 720p+ at full frame rate on most webcams).
ARIA_CAMERA_MJPG=1
